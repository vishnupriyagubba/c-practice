// given an array of size n. for every i from 0 to n-1 output maax(a[0],a[1],.......a[i]);
// approach: 1.keep a variable mx which stores the maximum till ith element 2. iterate over the array and update
// mx=max(mx,a[i])
#include<iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int mx;
    for(int i=0;i<n;i++){
        if(i==0){
            mx=arr[i];
        }
        else{
            mx=max(mx,arr[i]);
        }
        cout<<mx<<" ";
    }
    return 0;
}
