// searching a matrix
// 2 dimensional array

#include<iostream>
using namespace std;
int main(){
    int n,m;
    cin>>n>>m;
    float arr[n][m];
    // taking input
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin>>arr[i][j];
        }
    }
    // printing output
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cout<<arr[i][j]<<" ";
        }
        cout<<endl;
    }
    int x;
    cin>>x;
    bool flag=false;
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            if(arr[i][j]==x){
                cout<<"Element found at "<<i<<" "<<j<<endl;
                flag = true;
            }
        }
    }
    if(flag==false){
        cout<<"Element not found"<<endl;
    }
     return 0;
}
