// bit manipulation
#include<iostream>
using namespace std;
//get bit
int getbit(int n,int pos){
    return ((n& (1<<pos))!=0);

}
//setbit
int setbit(int n,int pos){
    return (n| (1<<pos));
}
//clear bit
int clearbit(int n,int pos){
    int mask=~(1<<pos);
    return (n & mask);
}
//update bit
int updatebit(int n,int pos,int value){
    n=clearbit(n,pos);
    int mask=value<<pos;
    return (n|mask);
}
int main(){
    cout<<getbit(5,3)<<endl;
    cout<<setbit(5,1)<<endl;
    cout<<clearbit(5,2)<<endl;
    cout<<updatebit(5,2,1)<<endl;
    return 0;
}
