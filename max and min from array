#include<iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int arr[n];
    
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int max=arr[0],min=arr[0];#int maxno=INT_MIN,minno=INT_MAX;
    for(int i=0;i<n;i++){
        if(arr[i]>max){
            max=arr[i];
        }
        if(arr[i]<min){
            min=arr[i];
        }
        
    }
    for(int i=0;i<n;i++){
        cout<<arr[i]<<endl;
    }
    cout<<"Maximum: "<<max<<endl;
    cout<<"Minimum: "<<min<<endl;
    return 0;
}
