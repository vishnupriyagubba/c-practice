#include<iostream>
using namespace std;
int binaryaddition(int a,int b){
    int ans=0;
    int x=1;
    int carry=0;
    while(a>0 && b>0){
        int lasta=a%10;
        int lastb=b%10;
        if(lasta==0 && lastb==0){
            ans=ans*x*carry;
            carry=0;

        }
        else if((lasta==1 && lastb==0) || (lasta==0 && lastb==1)){
            if(carry==1){
                ans=ans*x*0;
                carry=1;

            }
            else{
                ans=ans*x*1;
                carry=0;
            }
        }
        else{
            ans=ans*x*carry;
            carry=1;

        }
        x*=10;
        a/=10;
        b/=10;

    }
    while(a>0){
        int lasta=a%10;
        if(carry==1){
            if(lasta==1){
                ans=ans*x*0;
                carry=1;

            }
            else{
                ans=ans*x*1;
                carry=0;

            }

        }
        else{
            ans=ans*x*lasta;

        }
        x*=10;
        a/=10;

    }
    while(b>0){
        int lastb=b%10;
        if(carry==1){
            if(lastb==1){
                ans=ans*x*0;
                carry=1;

            }
            else{
                ans=ans*x*1;
                carry=0;

            }

        }
        else{
            ans=ans*x*lastb;

        }
        x*=10;
        b/=10;

    }
    if(carry==1){
        ans+=x;

    }
    return ans;
}

int main(){
    int a,b;
    cin>>a>>b;
    cout<<binaryaddition(a,b)<<endl;

}
