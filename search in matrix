// matrix search
// integers are stored in a 2D matrix. the matrix has the following properties:
// 1. integers in each row are sorted from left to right
// 2.integers in each column are sorted from top to bottom
// time complexity: O(n+m)
#include<iostream>
using namespace std;
int main(){
    int n,m;
    cin>>n>>m;
    int arr[n][m];
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin>>arr[i][j];
        }
    }
    int x;
    cin>>x;
    int row=0;
    int col=m-1;
    bool found=false;
    while(row<n && col>=0){
        if(arr[row][col]==x){
            cout<<"Element found at "<<row<<" "<<col<<endl;
            found=true;
            break;
        }
        else if(arr[row][col]>x){
            col--;
        }
        else{
            row++;
        }
    }
    if(!found){
        cout<<"Element not found"<<endl;
    }
    return 0;
}
